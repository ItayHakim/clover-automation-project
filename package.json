{
  "name": "cover-automation-project",
  "version": "1.0.0",
  "description": "Playwright automation tests for the Swag Labs demo shop website",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "allure:generate": "allure generate test-results/allure-results --output allure-report --clean",
    "allure:open": "allure open allure-report --host 127.0.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItayHakim/cover-automation-project.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ItayHakim/cover-automation-project/issues"
  },
  "homepage": "https://github.com/ItayHakim/cover-automation-project#readme",
  "dependencies": {
    "playwright": "^1.65.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "allure": "^3.33.0",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.10",
    "typescript": "^7.0.2"
  }
}
